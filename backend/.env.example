# FeeBridge Backend Production Environment Variables

SECRET_KEY=your-production-secret-key-change-me
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database Configuration (Render provides DATABASE_URL automatically)
DATABASE_URL=postgresql://feebridge_user:password@hostname:5432/feebridge

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://your-feebridge-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-feebridge-app.vercel.app,https://*.onrender.com

# Chapa Payment Gateway (Live or Test keys)
CHAPA_SECRET_KEY=CHASECK_TEST-your-chapa-secret-key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-chapa-public-key
CHAPA_WEBHOOK_SECRET=your-webhook-secret
CHAPA_API_URL=https://api.chapa.co/v1
